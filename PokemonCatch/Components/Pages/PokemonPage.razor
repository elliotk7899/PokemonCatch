@page "/pokemon"

<h3>Pokemon</h3>

<MudTable Items="Game.User.PokemonCaught" Hover="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.TypeName)">Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Gender)">Gender</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Weight)">Weight</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Height)">Height</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (context.IsShiny)
        {
            <MudTd DataLabel="Name">@context.Name&nbsp;<MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" /></MudTd>
        }
        else
        {
            <MudTd DataLabel="Name">@context.Name</MudTd>
        }

        <MudTd DataLabel="Type">@context.TypeName</MudTd>
        
        @if(context.Gender == "Male")
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;<MudIcon Icon="@Icons.Material.Filled.Male" Color="Color.Info" /></MudTd>
        } else if (context.Gender == "Female")
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;<MudIcon Icon="@Icons.Material.Filled.Female" Color="Color.Secondary" /></MudTd>
        } else
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;</MudTd>
        }

        <MudTd DataLabel="Weight">@context.Weight lbs</MudTd>
        <MudTd DataLabel="Height">@context.Height</MudTd>
    </RowTemplate>
    @* Add two buttons, one to view, and one to sell with a confirmation dialog and the amount sold in the button name. *@
</MudTable>

@code {

}
