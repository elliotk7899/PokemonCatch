@page "/pokemon"
@using Classes
@inject IDialogService DialogService

<style>
    body {
        background-color: lightblue;
    }
</style>

<MudTable Items="Game.User.PokemonCaught" Hover="true" Filter="new Func<Pokemon, bool>(FilterFunc1)" Style="background-color: antiquewhite;">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Pokemon</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.TypeName)">Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Gender)">Gender</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Weight)">Weight</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Pokemon, object>(x => x.Height)">Height</MudTableSortLabel></MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (context.IsShiny)
        {
            <MudTd DataLabel="Name">@context.Name&nbsp;<MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" /></MudTd>
        }
        else
        {
            <MudTd DataLabel="Name">@context.Name</MudTd>
        }

        <MudTd DataLabel="Type">@context.TypeName</MudTd>
        
        @if(context.Gender == "Male")
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;<MudIcon Icon="@Icons.Material.Filled.Male" Color="Color.Info" /></MudTd>
        } else if (context.Gender == "Female")
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;<MudIcon Icon="@Icons.Material.Filled.Female" Color="Color.Secondary" /></MudTd>
        } else
        {
            <MudTd DataLabel="Gender">@context.Gender&nbsp;</MudTd>
        }

        <MudTd DataLabel="Weight">@context.Weight lbs</MudTd>
        <MudTd DataLabel="Height">@context.Height</MudTd>
        <MudTd DataLabel="View" Class="text-end"><MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenViewDialogAsync(context)">View</MudButton></MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100, int.MaxValue }"RowsPerPageString="Pokemon per page:" />
    </PagerContent>
</MudTable>

<br>

@code {
    private string searchString1 = "";

    private bool FilterFunc1(Pokemon element) => FilterFunc(element, searchString1);

    private bool FilterFunc(Pokemon element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.TypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Gender.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Height.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{element.Weight}".Contains(searchString))
            return true;
        return false;
    }

    private async Task OpenViewDialogAsync(Pokemon Selected)
    {
        var parameters = new DialogParameters<ViewDialog> { { x => x.Chosen, Selected } };

        var DialogView = await DialogService.ShowAsync<ViewDialog>("View Dialog", parameters);
        var DialogResult = await DialogView.Result;

        if (!DialogResult.Canceled)
        {
            StateHasChanged();
        }
    }
}
