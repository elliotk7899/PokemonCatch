@page "/"
@using Classes
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Home</PageTitle>

<style>
    body {
        background-color: antiquewhite;
    }
</style>

<MudGrid>
    <MudItem xs="12">
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" Style="background-color: white;">
            <MudTabPanel Text="Player Info">
                <MudStack Row="true">
                    <MudText Typo="Typo.h4">Trainer @Game.User.Name</MudText>
                    <MudSpacer />
                    <MudText Style="color: forestgreen;" Typo="Typo.h4">$@Game.User.Money</MudText>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Bag">
                <MudStack Row="true" Justify="Justify.Center">
                    @foreach (var Ball in Game.User.Bag)
                    {
                        <MudText Typo="Typo.h5">@Ball.Name (@Ball.Number)</MudText>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Options">
                <MudStack Row="true" Justify="Justify.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenNameDialogAsync">Change Name</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveData">Save Data</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ResetData">Reset Data</MudButton>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </MudItem>

    <MudItem xs="4">
        <MudProgressCircular Style="height: 300px; width: 300px; display: block; margin-left: auto; margin-right: auto;" Color="Color.Error" Value="@Game.User.PokemonEntered.Count" Min="0" Max="@PokemonReference.AllPokemon.Length">
            <ChildContent>
                <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudText Typo="Typo.subtitle2">Pokemon Caught</MudText>
                    <MudText Typo="Typo.subtitle2">@Game.User.PokemonEntered.Count / @PokemonReference.AllPokemon.Length</MudText>
                </MudStack>
            </ChildContent>
        </MudProgressCircular>
    </MudItem>

    <MudItem xs="4">
        <MudProgressCircular Style="height: 300px; width: 300px; display: block; margin-left: auto; margin-right: auto;" Color="Color.Success" Value="@(WildArea.NumAreasUnlocked(Game.User.PlayerLevel.LevelNum))" Min="0" Max="@WildArea.Areas.Length">
            <ChildContent>
                <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudText Typo="Typo.subtitle2">Areas Unlocked</MudText>
                    <MudText Typo="Typo.subtitle2">@WildArea.NumAreasUnlocked(Game.User.PlayerLevel.LevelNum) / @WildArea.Areas.Length</MudText>
                </MudStack>
            </ChildContent>
        </MudProgressCircular>
    </MudItem>

    <MudItem xs="4">
        <MudProgressCircular Style="height: 300px; width: 300px; display: block; margin-left: auto; margin-right: auto;" Color="Color.Info" Value="@Game.User.PlayerLevel.Xp" Min="0" Max="@(Game.User.PlayerLevel.LevelNum * 25)">
            <ChildContent>
                <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudText Typo="Typo.subtitle2">Level</MudText>
                    <MudText Typo="Typo.h3">@Game.User.PlayerLevel.LevelNum</MudText>
                </MudStack>
            </ChildContent>
        </MudProgressCircular>
    </MudItem>
</MudGrid>

<br>


@code {
    private bool ConfirmVisible { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Game.HasData)
        {
            Game.GetData();
            StateHasChanged();
        }
    }

    private void SaveData()
    {
        Game.SaveData();

        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
        Snackbar.Add("Data Saved!", Severity.Success);
    }

    private void ResetData()
    {
        Game.ResetData();
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
        Snackbar.Add("Data has been reset!", Severity.Error);
        StateHasChanged();
    }

    private async Task OpenNameDialogAsync()
    {
        var DialogView = await DialogService.ShowAsync<NameDialog>("Name Dialog");
        var DialogResult = await DialogView.Result;

        if (!DialogResult.Canceled)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
            Snackbar.Add("Your name has been changed to " + Game.User.Name, Severity.Info);

            StateHasChanged();
        }
    }
}


