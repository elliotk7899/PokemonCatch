@page "/shop"
@using Classes
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    body {
        background-color: lightblue;
    }
</style>

<MudText Typo="Typo.h6" Style="color: forestgreen; text-align: right;">$@Game.User.Money</MudText>

<MudText Typo="Typo.h3" Style="text-align: center; text-decoration: underline;">Shop</MudText>

<br>

<MudGrid Justify="Justify.Center">
    @foreach (var Ball in Pokeball.AllPokeBalls)
    {
        <MudItem xs="3">
            <MudPaper Class="pa-2" Style="background-color: antiquewhite;">
                <MudStack Justify="Justify.Center">
                    <MudText Typo="Typo.h4" Style="text-align: center;">@Ball.Name</MudText>
                    <MudImage Src="@Ball.Image" Alt="@Ball.Name" Style="width: 300px; height: auto; margin-left: -10px" />
                    <MudItem Style="height: 100px;">
                        <MudText>@Ball.Description</MudText>
                    </MudItem>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenBuyDialogAsync(Ball)">Buy ($@Ball.Price)</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<br>

@code {
    private Pokeball SelectedBall;

    protected override async Task OnInitializedAsync()
    {
        if (!Game.HasData)
        {
            Game.GetData();
            StateHasChanged();
        }
    }

    // Checks to see if the player can afford the purchase and gives the player the purchase if they can.
    private void Buy(int Amount)
    {
        Snackbar.Clear();

        int Cost = Amount * SelectedBall.Price;

        if (Game.User.Money >= Cost)
        {
            Game.User.Money -= Cost;
            Game.User.Bag[Pokeball.AllPokeBalls.IndexOf(SelectedBall)].Number += Amount; 

            if (Amount > 1)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
                Snackbar.Add("Purchased " + Amount + " " + SelectedBall.Name + "s!", Severity.Success);
            } else
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
                Snackbar.Add("Purchased " + Amount + " " + SelectedBall.Name + "!", Severity.Success);
            }
            
        } else
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
            Snackbar.Add("Not enough money!", Severity.Error);
        }
    }

    // Opens the ShopDialog to allow the player to select the number of the ChosenBall they wish to buy.
    private async Task OpenBuyDialogAsync(Pokeball ChosenBall)
    {
        SelectedBall = ChosenBall;

        var parameters = new DialogParameters<ShopDialog> { { x => x.SelectedBall, SelectedBall } };

        var DialogShop = await DialogService.ShowAsync<ShopDialog>("Shop Dialog", parameters);
        var DialogResult = await DialogShop.Result;

        if (!DialogResult.Canceled)
        {
            int Quantity = await DialogShop.GetReturnValueAsync<int>();
            Buy(Quantity);
        }
    }
}
