@page "/route2"
@using Classes
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    body {
        background-color: lightgreen;
    }
</style>

<MudGrid Justify="Justify.Center">

    <MudItem><h2 style="color: black; text-decoration: underline;">Route 2</h2></MudItem>
    <MudFlexBreak />
    <MudItem><MudButton Variant="Variant.Filled" Color="Color.Info" Disabled="@(Searching || Game.User.PlayerLevel.LevelNum < RouteLevel)" OnClick="Encounter">Search</MudButton></MudItem>

    <MudFlexBreak />
    <MudItem>@if (Game.User.PlayerLevel.LevelNum < RouteLevel) 
        {
            <MudAlert Severity="Severity.Error">Your level is too low to search this area.</MudAlert>
        }
    </MudItem>
        <MudFlexBreak />

    @if(Searching)
    {
        <MudItem xs="6">
            <MudPaper Style="background-color: rgb(214, 250, 193)">
                <MudGrid Justify="Justify.Center">
                    <MudItem>
                        <MudElement HtmlTag="h3">
                            @PokemonEncountered.Name&nbsp;@if(PokemonEncountered.Gender == "Male")
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Male" Color="Color.Info" />
                            }
                    else if (PokemonEncountered.Gender == "Female")
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Female" Color="Color.Secondary" />
                            }
                            @if (PokemonEncountered.IsShiny)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                            }
                        </MudElement>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem>
                        <div class="d-flex justify-center">
                            <MudImage Src="@PokemonImage" Alt="@PokemonName" Style="width: 75%; height: auto;" />
                        </div>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem>
                        <MudText>Type: @PokemonEncountered.TypeName</MudText>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem>
                        <MudText>Weight: @PokemonEncountered.Weight lbs</MudText>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem>
                        <MudText>Height: @PokemonEncountered.Height</MudText>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenCatchDialogAsync" Disabled="@Catching">Catch</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Run" Disabled="@Catching">Run</MudButton>
                    </MudItem>
                    <MudFlexBreak />
                    <MudItem></MudItem>
                </MudGrid>
                
            </MudPaper>
        </MudItem>
    }

    <MudFlexBreak />
    <MudItem></MudItem>

</MudGrid>



@code {
    private bool Searching = false;
    private bool Catching = false;
    private int RouteLevel = 5;
    private string PokemonImage { get; set; }
    private string PokemonName { get; set; }
    private Pokemon PokemonEncountered { get; set; }
    private PokemonReference[] NativePokemon = 
    { 
        PokemonReference.FindPokemon("Pidgey"), 
        PokemonReference.FindPokemon("Rattata"), 
        PokemonReference.FindPokemon("Caterpie"), 
        PokemonReference.FindPokemon("Weedle"),
        PokemonReference.FindPokemon("Nidoran (Female)"),
        PokemonReference.FindPokemon("Nidoran (Male)")
    };

    private PokemonReference Selected { get; set; }

    Random rand = new Random();

    protected override async Task OnInitializedAsync()
    {
        if (!Game.HasData)
        {
            Game.GetData();
            StateHasChanged();
        }
    }

    private void Encounter()
    {
        Searching = true;

        double NativeValue = 0;
        var EncounterList = new List<PokemonReference>();
        var LegendaryList = new List<PokemonReference>();

        foreach (var HomePokemon in NativePokemon)
        {
            if (HomePokemon.Value < 975)
            {
                NativeValue += HomePokemon.Value;
            }
        }

        foreach (var HomePokemon in NativePokemon)
        {
            if (HomePokemon.Value >= 975)
            {
                LegendaryList.Add(HomePokemon);
            } else
            {
                int Chance = (int)(Math.Round((1000 - ((HomePokemon.Value / NativeValue) * 100))));

                for (int i = 0; i < Chance; i++)
                {
                    EncounterList.Add(HomePokemon);
                }
            }
        }

        if (LegendaryList.Count > 0)
        {
            int EncounterNum = rand.Next(1, 1001);
            if (EncounterNum == 1)
            {
                Selected = NativePokemon[rand.Next(0, NativePokemon.Length)];
            } else
            {
                EncounterNum = rand.Next(0, EncounterList.Count);
                Selected = NativePokemon[EncounterNum];
            }
        } else
        {
            int EncounterNum = rand.Next(0, EncounterList.Count);
            Selected = EncounterList[EncounterNum];
        }

        PokemonEncountered = Pokemon.CreatePokemon(Selected);

        PokemonImage = PokemonEncountered.Image;
        PokemonName = PokemonEncountered.Name;
        StateHasChanged();
    }

    private void Run()
    {
        Searching = false;
    }

    private async Task TryCatch(Pokeball Ball)
    {
        Catching = true;

        Ball.Number -= 1;

        int Shakes = 0;

        PokemonImage = Ball.Image;
        PokemonName = Ball.Name;
        StateHasChanged();

        Snackbar.Clear();

        while (Shakes <= 3)
        {
            await Task.Delay(2000);

            int CatchNum = rand.Next(1, 1001);
            int ChanceNum = 1000 - ((int)Math.Floor(((1 - (Selected.Value / 1000)) * Ball.CatchChance) * 1000));

            if (CatchNum >= ChanceNum || Ball.Name.Equals("Master Ball"))
            {
                Shakes += 1;

                if (Shakes != 4)
                {
                    string ShakingMessage = "Shaking";

                    for (int i = 0; i < Shakes; i++)
                    {
                        ShakingMessage += ".";
                    }

                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
                    Snackbar.Add(ShakingMessage, Severity.Warning);
                }
            } else
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
                Snackbar.Add(PokemonEncountered.Name + " escaped!", Severity.Error);

                PokemonImage = PokemonEncountered.Image;
                PokemonName = PokemonEncountered.Name;
                StateHasChanged();

                break;
            }
        }

        if (Shakes == 4)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
            Snackbar.Add("Caught!!!", Severity.Success);

            if (!PokemonReference.PokemonFoundInList(Selected, Game.User.PokemonEntered))
            {
                Game.User.PokemonEntered.Add(Selected);
            }

            Game.User.PokemonCaught.Add(PokemonEncountered);

            Game.User.PlayerLevel.AddExp(Selected.Value);

            await Task.Delay(2000);

            Searching = false;
        }

        Catching = false;
        StateHasChanged();
    }

    private async Task OpenCatchDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var DialogCatch = await DialogService.ShowAsync<CatchDialog>("Catch Dialog", options);
        var DialogResult = await DialogCatch.Result;

        if (!DialogResult.Canceled)
        {
            Pokeball SelectedBall = await DialogCatch.GetReturnValueAsync<Pokeball>();
            TryCatch(SelectedBall);
        }
    }
}
