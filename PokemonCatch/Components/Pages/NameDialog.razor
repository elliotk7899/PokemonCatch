
<MudDialog>
    <DialogContent>
        <MudForm @ref="NameForm" @bind-IsValid="@ValidName">
            <MudTextField @bind-Value="Name" Label="Outlined" Variant="Variant.Outlined" Required="true"></MudTextField>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton>Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm NameForm;
    private string Name { get; set; }
    private bool ValidName { get; set; }
}
