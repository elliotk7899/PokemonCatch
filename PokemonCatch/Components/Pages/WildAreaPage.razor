@page "/wildarea"
@using Classes

<style>
    body {
        background-color: lightgreen;
    }
</style>

<MudTable Items="@WildArea.Areas" Hover="true" Style="background-color: antiquewhite;">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Wild Area</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Area</MudTh>
        <MudTh>Level Needed</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Area">@context.Name</MudTd>
        <MudTd DataLabel="Level Needed">@context.RequiredLevel</MudTd>
        <MudTd Class="text-end"><MudButton Href="@context.Link" Variant="Variant.Filled" Color="Color.Success" Disabled="Game.User.PlayerLevel.LevelNum < context.RequiredLevel">Go</MudButton></MudTd>
    </RowTemplate>
</MudTable>


@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Game.HasData)
        {
            Game.GetData();
            StateHasChanged();
        }
    }


}
